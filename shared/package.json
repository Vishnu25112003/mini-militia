{
  "name": "@game/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./maps/catacombs.json": "./maps/catacombs.json",
    "./maps/tileset.png": "./maps/tileset.png",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-map": "tsx maps/generate.ts",
    "validate-map": "tsx maps/validate.ts",
    "prebuild": "npm run validate-map",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4"
  }
}
